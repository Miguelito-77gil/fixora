import { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";

import {
  fetchMyRepairRequests,
  updateRepairRequestStatus,
} from "@/services/repairService";

import { fetchChatUsers } from "@/services/marketplaceService";

function RepairerDashboard() {
  const navigate = useNavigate();

  const [requests, setRequests] = useState([]);
  const [loading, setLoading] = useState(true);
  const [updatingId, setUpdatingId] = useState(null);
  const [error, setError] = useState("");

  const [messageCount, setMessageCount] = useState(0);

  async function loadRequests() {
    try {
      setLoading(true);
      setError("");

      const data = await fetchMyRepairRequests();
      setRequests(Array.isArray(data) ? data : []);
    } catch (err) {
      console.error("Failed to load repair requests:", err);
      setError(err.message || "Failed to load repair requests.");
    } finally {
      setLoading(false);
    }
  }

  async function loadMessageCount() {
    try {
      const users = await fetchChatUsers();

      setMessageCount(Array.isArray(users) ? users.length : 0);
    } catch (err) {
      console.error("Failed to load messages:", err);
      setMessageCount(0);
    }
  }

  async function handleStatusChange(id, status) {
    try {
      setUpdatingId(id);

      await updateRepairRequestStatus(id, status);

      await loadRequests();
    } catch (err) {
      console.error("Failed to update request:", err);
      setError(err.message || "Failed to update request.");
    } finally {
      setUpdatingId(null);
    }
  }

  useEffect(() => {
    loadRequests();
    loadMessageCount();

    const interval = setInterval(() => {
      loadMessageCount();
    }, 3000);

    return () => clearInterval(interval);
  }, []);

  function getStatusStyle(status) {
    switch (status) {
      case "accepted":
        return "bg-green-100 text-green-700 border-green-200";

      case "in_progress":
        return "bg-blue-100 text-blue-700 border-blue-200";

      case "completed":
        return "bg-emerald-100 text-emerald-700 border-emerald-200";

      case "cancelled":
        return "bg-red-100 text-red-700 border-red-200";

      default:
        return "bg-[#f3e5da] text-[#8b5e3c] border-[#dfcabb]";
    }
  }

  function formatStatus(status) {
    return String(status || "pending")
      .replace("_", " ")
      .replace(/\b\w/g, (letter) => letter.toUpperCase());
  }

  function formatSchedule(schedule) {
    if (!schedule) return "Not specified";

    const date = new Date(schedule);

    if (Number.isNaN(date.getTime())) {
      return schedule;
    }

    return date.toLocaleString("en-US", {
      month: "long",
      day: "numeric",
      year: "numeric",
      hour: "numeric",
      minute: "2-digit",
      hour12: true,
    });
  }

  function getDetail(description, label) {
    const line = String(description || "")
      .split("\n")
      .find((item) => item.startsWith(`${label}:`));

    return line ? line.replace(`${label}:`, "").trim() : "";
  }

  return (
    <section className="mx-auto max-w-6xl px-6 py-12 sm:py-20">

      {/* DASHBOARD HEADER */}
      <div className="flex items-start justify-between gap-6">

        <div>
          <p className="text-xs font-bold uppercase tracking-[0.2em] text-[#b9825f]">
            Repairer Dashboard
          </p>

          <h1 className="mt-3 text-4xl font-black tracking-tight text-[#2f241e]">
            Repair Requests
          </h1>

          <p className="mt-3 max-w-2xl text-[#75675f]">
            Manage customer repair requests and update their progress.
          </p>
        </div>

        {/* MESSAGE ICON */}

      </div>

      {/* LOADING */}
          <div className="relative mt-10">
          <button
            type="button"
            onClick={() => navigate("/messages")}
            aria-label="Messages"
            title="Messages"
            className="absolute right-5 -top-5 z-20 flex h-10 w-10 items-center justify-center rounded-full border border-[#d8c8bc] bg-white text-[#8b5e3c] shadow-sm transition hover:bg-[#f7eee8] hover:shadow-md"
          >
            {messageCount > 0 && (
              <span className="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full border border-white bg-[#b9825f] px-1 text-[9px] font-black leading-none text-white shadow-sm">
                {messageCount > 99 ? "99+" : messageCount}
              </span>
            )}

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
              className="h-5 w-5"
            >
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
            </svg>
          </button>
 (
        <div className="mt-10 rounded-3xl border border-[#e4d9d0] px-6 py-20 text-center">
          <p className="text-sm text-[#75675f]">
            Loading repair requests...
          </p>
        </div>
      )}

      {/* ERROR */}
      {!loading && error && (
        <div className="mt-10 rounded-2xl border border-red-300 bg-red-50 px-5 py-4">
          <p className="text-sm text-red-700">
            {error}
          </p>

          <button
            type="button"
            onClick={loadRequests}
            className="mt-4 rounded-xl bg-[#b9825f] px-4 py-2 text-sm font-bold text-white transition hover:bg-[#a9704e]"
          >
            Try Again
          </button>
        </div>
      )}

      {/* NO REQUESTS */}
      {!loading && !error && requests.length === 0 && (
        <div className="mt-10 rounded-3xl border border-dashed border-[#d8c8bc] px-6 py-24 text-center">
          <h2 className="text-xl font-bold text-[#2f241e]">
            No repair requests yet
          </h2>

          <p className="mx-auto mt-3 max-w-md text-sm leading-7 text-[#75675f]">
            Customer requests assigned to you will appear here.
          </p>
        </div>
      )}

      {/* REQUESTS */}
      {!loading && !error && requests.length > 0 && (
        <div className="mt-10 space-y-6">

          {requests.map((request) => {
            const description = String(request.description || "");

            const item =
              getDetail(description, "Item") ||
              request.service ||
              "Repair Request";

            const category =
              getDetail(description, "Category") ||
              "Repair Service";

            const location =
              getDetail(description, "Location") ||
              "Not specified";

            const problem =
              getDetail(description, "Problem") ||
              "No problem description provided.";

            const notes =
              getDetail(description, "Additional notes");

            const schedule =
              getDetail(description, "Preferred schedule");

            const isUpdating = updatingId === request.id;

            return (
              <article
                key={request.id}
                className="rounded-3xl border border-[#e4d9d0] bg-white/80 p-6 shadow-sm"
              >
                <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

                  <div>
                    <p className="text-xs font-bold uppercase tracking-[0.16em] text-[#b9825f]">
                      Request #{request.id}
                    </p>

                    <h2 className="mt-2 text-2xl font-black text-[#2f241e]">
                      {item}
                    </h2>

                    <p className="mt-1 text-sm text-[#75675f]">
                      Customer: {request.customer_name || "Customer"}
                    </p>
                  </div>

                  <span
                    className={`inline-flex w-fit rounded-full border px-3 py-1 text-xs font-bold ${getStatusStyle(
                      request.status
                    )}`}
                  >
                    {formatStatus(request.status)}
                  </span>

                </div>

                <div className="mt-6 grid gap-4 sm:grid-cols-2">

                  <div>
                    <p className="text-xs font-bold uppercase tracking-wider text-[#9a6541]">
                      Category
                    </p>
                    <p className="mt-1 text-sm text-[#2f241e]">
                      {category}
                    </p>
                  </div>

                  <div>
                    <p className="text-xs font-bold uppercase tracking-wider text-[#9a6541]">
                      Location
                    </p>
                    <p className="mt-1 text-sm text-[#2f241e]">
                      {location}
                    </p>
                  </div>

                  <div>
                    <p className="text-xs font-bold uppercase tracking-wider text-[#9a6541]">
                      Preferred Schedule
                    </p>
                    <p className="mt-1 text-sm text-[#2f241e]">
                      {formatSchedule(schedule)}
                    </p>
                  </div>

                  <div>
                    <p className="text-xs font-bold uppercase tracking-wider text-[#9a6541]">
                      Service
                    </p>
                    <p className="mt-1 text-sm text-[#2f241e]">
                      {request.service || category}
                    </p>
                  </div>

                </div>

                <div className="mt-6 border-t border-[#eee5df] pt-5">

                  <p className="text-xs font-bold uppercase tracking-wider text-[#9a6541]">
                    Problem
                  </p>

                  <p className="mt-2 text-sm leading-7 text-[#4f443d]">
                    {problem}
                  </p>

                  {notes && (
                    <div className="mt-4">
                      <p className="text-xs font-bold uppercase tracking-wider text-[#9a6541]">
                        Additional Notes
                      </p>

                      <p className="mt-2 text-sm leading-7 text-[#4f443d]">
                        {notes}
                      </p>
                    </div>
                  )}

                </div>

                {request.status === "pending" && (
                  <div className="mt-6 flex flex-col gap-3 border-t border-[#eee5df] pt-5 sm:flex-row">

                    <button
                      type="button"
                      disabled={isUpdating}
                      onClick={() =>
                        handleStatusChange(request.id, "accepted")
                      }
                      className="rounded-xl bg-[#b9825f] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#a9704e] disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      {isUpdating ? "Updating..." : "Accept Request"}
                    </button>

                    <button
                      type="button"
                      disabled={isUpdating}
                      onClick={() =>
                        handleStatusChange(request.id, "cancelled")
                      }
                      className="rounded-xl border border-[#d8c8bc] px-5 py-3 text-sm font-bold text-[#8b5e3c] transition hover:bg-[#f7eee8] disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      Decline Request
                    </button>

                  </div>
                )}

                {request.status === "accepted" && (
                  <div className="mt-6 flex gap-3 border-t border-[#eee5df] pt-5">

                    <button
                      type="button"
                      disabled={isUpdating}
                      onClick={() =>
                        handleStatusChange(request.id, "in_progress")
                      }
                      className="rounded-xl bg-[#b9825f] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#a9704e] disabled:opacity-60"
                    >
                      {isUpdating ? "Updating..." : "Start Repair"}
                    </button>

                  </div>
                )}

                {request.status === "in_progress" && (
                  <div className="mt-6 flex gap-3 border-t border-[#eee5df] pt-5">

                    <button
                      type="button"
                      disabled={isUpdating}
                      onClick={() =>
                        handleStatusChange(request.id, "completed")
                      }
                      className="rounded-xl bg-[#b9825f] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#a9704e] disabled:opacity-60"
                    >
                      {isUpdating ? "Updating..." : "Mark Completed"}
                    </button>

                  </div>
                )}

              </article>
            );
          })}

        </div>
      )}

    </section>
  );
}

export default RepairerDashboard;
